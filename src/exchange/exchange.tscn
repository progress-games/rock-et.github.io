[connection signal="pressed" from="Tutorial/Increase" to="ExchangeRunner" method="increase_transfer_amount"]
[connection signal="mouse_entered" from="Tutorial/Decrease" to="ExchangeRunner" method="hover" binds= ["decrease"]]
[connection signal="mouse_exited" from="Tutorial/Decrease" to="ExchangeRunner" method="off_hover" binds= ["decrease"]]
[connection signal="pressed" from="Tutorial/Decrease" to="ExchangeRunner" method="decrease_transfer_amount"]
